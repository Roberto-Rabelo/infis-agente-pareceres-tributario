  "versaoContrato": "1.0.0",
  "loteId": "http-aptas",
  "contribuinte": { "cnpj": "11222333" },
  "periodo": { "inicio": "2026-03-01", "fim": "2026-03-31" },
  "obrigacoes": [
    {
      "id": "efd-icms-1",
      "tipo": "EFD_ICMS_IPI",
      "versaoLayout": "020",
      "contribuinte": { "cnpj": "11222333000181", "inscricaoEstadual": "110042490114", "uf": "SP" },
      "periodo": { "inicio": "2026-03-01", "fim": "2026-03-31" },
      "finalidade": "ORIGINAL",
      "identificacao": { "recibo": "REC-1", "hash": "HASH-REC-1" },
      "validacaoOrigem": { "agente": "agente-validador-teste", "versaoValidador": "1.0.0", "dataValidacao": "2026-04-10T10:00:00-03:00", "status": "APROVADO", "ocorrencias": [] },
      "registros": {
        "0000": [ { "linha": 1, "campos": { "COD_VER": "020", "CNPJ": "11222333000181", "DT_INI": "2026-03-01", "DT_FIN": "2026-03-31" } } ]
      }
    },
    {
      "id": "nfe-1",
      "tipo": "NFE",
      "versaoLayout": "4.00",
      "contribuinte": { "cnpj": "11222333000181", "inscricaoEstadual": "110042490114", "uf": "SP" },
      "periodo": { "inicio": "2026-03-10", "fim": "2026-03-10" },
      "finalidade": "ORIGINAL",
      "identificacao": { "chaveAcesso": "35260311222333000181550010000000011000000010" },
      "validacaoOrigem": {
        "agente": "agente-validador-teste", "versaoValidador": "1.0.0", "dataValidacao": "2026-04-10T10:00:00-03:00", "status": "APROVADO",
