<Project Sdk="Microsoft.NET.Sdk.Web"><PropertyGroup>  <UserSecretsId>4612b8dc-71b0-4fb4-88e8-eb4c7c5f7054</UserSecretsId>
    <!-- Comentários XML alimentam a documentação OpenAPI; membros sem comentário não bloqueiam o build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.81.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.3.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Api.Agente.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\catalog\*.json" Link="catalog\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\contracts\saida\*.json" Link="contracts\saida\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\prompts\parecer\*.md" Link="prompts\parecer\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\exemplos\lote-exemplo.json" Link="exemplos\lote-exemplo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
