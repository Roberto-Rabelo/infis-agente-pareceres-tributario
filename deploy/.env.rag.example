# Segundo projeto Vercel (Root Directory = . e Dockerfile = deploy/Dockerfile.vercel.rag).
# Sem ConnectionStrings__Rag + OpenAI a ingestão/consulta RAG não funciona.

ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Rag=Host=SEU-NEON;Database=rag;Username=;Password=;SSL Mode=Require;Trust Server Certificate=true
Postgres__AplicarMigracoes=true
OpenAI__ApiKey=
Embeddings__Modelo=text-embedding-3-small
Embeddings__Dimensao=1536
Autenticacao__Authority=https://SEU-ISSUER
Autenticacao__Audience=agente-parecer
