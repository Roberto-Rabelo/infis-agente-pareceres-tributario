# Teste primário na Vercel: TODOS os recursos JÁ IMPLEMENTADOS ligados.
# Copiar nomes para Project → Environment Variables. Nunca versionar valores reais.
# Sem OpenAI, Neon e JWT o container NÃO sobe (Parecer habilitado exige os três).

ASPNETCORE_ENVIRONMENT=Production

# --- Obrigatórios para cruzamento + parecer + consumo ---
Parecer__Habilitado=true
Parecer__Modelo=gpt-4o-mini
Parecer__TimeoutSegundos=60
OpenAI__ApiKey=
ConnectionStrings__Agente=Host=SEU-NEON;Database=agente;Username=;Password=;SSL Mode=Require;Trust Server Certificate=true
Postgres__AplicarMigracoes=true

# --- Obrigatórios para fundamentação RAG (Api.RAG em outro projeto Vercel) ---
BaseConhecimento__Endpoint=https://SEU-RAG.vercel.app/mcp
BaseConhecimento__TokenAcesso=
BaseConhecimento__TimeoutSegundos=30

# --- A2A / CORS / JWT ---
A2A__Url=https://SEU-AGENTE.vercel.app/a2a
A2A__IdAgente=agente-parecer-tributario
A2A__Nome=Agente Parecer Tributário
Cors__AllowedOrigins__0=
Autenticacao__Authority=https://SEU-ISSUER
Autenticacao__Audience=agente-parecer
RateLimiting__PermitLimitPorMinuto=60

# Memória Mongo (D9) ainda NÃO está no código — não faz parte deste teste.

# --- Só local (docker compose -f docker-compose.rag.yml). Não copiar para a Vercel. ---
# RAG_POSTGRES_PASSWORD=
# AGENTE_POSTGRES_PASSWORD=
# PGADMIN_DEFAULT_EMAIL=admin@local.dev
# PGADMIN_DEFAULT_PASSWORD=
# ConnectionStrings__Rag=Host=localhost;Port=5433;Database=rag;Username=rag;Password=
# ConnectionStrings__Agente=Host=localhost;Port=5434;Database=agente;Username=agente;Password=
