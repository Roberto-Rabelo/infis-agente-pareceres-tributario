# Projeto Vercel único com dois services (vercel.json): agente em / e rag em /rag/*.
# As variáveis do projeto são compartilhadas pelos dois services; os nomes não colidem.
# Gere os valores com `sh scripts/preparar-vercel.sh https://SEU-PROJETO.vercel.app` (cria .env.vercel, gitignored).
# Este arquivo é versionado: só nomes e exemplos, nunca valores reais.

ASPNETCORE_ENVIRONMENT=Production

# --- JWT (modo de teste por chave simétrica HS256; com IdP, use Autenticacao__Authority no lugar) ---
Autenticacao__ChaveSimetrica=
Autenticacao__Emissor=infis-agente-parecer-teste
Autenticacao__Audience=agente-parecer

# --- OpenAI: parecer (agente) e embeddings (rag) ---
OpenAI__ApiKey=

# --- Neon (formato Npgsql chave=valor, endpoint direto sem -pooler) ---
ConnectionStrings__Agente=Host=SEU-NEON.neon.tech;Database=agente;Username=;Password=;SSL Mode=Require
ConnectionStrings__Rag=Host=SEU-NEON.neon.tech;Database=rag;Username=;Password=;SSL Mode=Require
Postgres__AplicarMigracoes=true

# --- Parecer + fundamentação MCP (agente -> rag pela URL pública) ---
Parecer__Habilitado=true
Parecer__Modelo=gpt-4o-mini
BaseConhecimento__Endpoint=https://SEU-PROJETO.vercel.app/rag/mcp
BaseConhecimento__TokenAcesso=
BaseConhecimento__TimeoutSegundos=30

# --- A2A / borda ---
A2A__Url=https://SEU-PROJETO.vercel.app/a2a
# Chave Bearer compartilhada da SOFIA (skill sofia-a2a-autenticacao): protege o Agent Card e o /a2a.
# Mínimo 16 caracteres; sem ela a integração A2A fica indisponível. Segredo: não versionar.
SOFIA_A2A_TOKEN=
RateLimiting__PermitLimitPorMinuto=60
# Cors__AllowedOrigins__0=   (só se houver frontend no navegador)

# Memória Mongo (D9) ainda NÃO está no código — não faz parte deste teste.

# --- Só local (docker compose). Não copiar para a Vercel. ---
# RAG_POSTGRES_PASSWORD=
# AGENTE_POSTGRES_PASSWORD=
# PGADMIN_DEFAULT_EMAIL=admin@local.dev
# PGADMIN_DEFAULT_PASSWORD=
# OPENAI_API_KEY=
