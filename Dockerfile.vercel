# Container HTTP da Api.Agente para Vercel Container Runtime (Hobby, beta).
# Host: src/Api.Agente/Api.Agente.csproj → Api.Agente.dll
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore "src/Api.Agente/Api.Agente.csproj"
RUN dotnet publish "src/Api.Agente/Api.Agente.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_ENVIRONMENT=Production
ENV APP_DLL="Api.Agente.dll"
# Parecer e demais recursos ligam por variáveis da Vercel (.env.example), não por padrão da imagem.
# A Vercel roteia para a porta 80 e não injeta PORT; PORT só muda a porta se cadastrada no projeto (ou em teste local).
CMD ["sh", "-c", "export ASPNETCORE_URLS=\"http://0.0.0.0:${PORT:-80}\"; exec dotnet \"$APP_DLL\""]
